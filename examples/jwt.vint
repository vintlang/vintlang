// import jwt
const jwt = import("jwt") // Both ways work

const secret: string = "vint-is-so-awaseome"
// Create a JWT token
let payload: {string: string} = {"user": "Tachera", "role": "admin"}
let token: string = jwt.create(payload, secret)
::info "token is " + token

const decoded: any = jwt.decode(token)

::println("DECODED", decoded)

// Verify the token
let result: any = jwt.verify(token, secret)
if (result) {
    ::println("User:", result["user"])
    ::println("Role:", result["role"])
}
