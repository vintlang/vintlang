// VintLang Closures & Higher-Order Functions Example
// Demonstrates closures, function factories, and higher-order patterns

// ============================================================
// 1. Basic closure: a function that captures its environment
// ============================================================
let makeCounter = func(): func() int {
    let count: int = 0;
    return func(): int {
        count = count + 1;
        return count;
    };
};

let counter: func() int = makeCounter();
::println("Counter:", counter());
::println("Counter:", counter());
::println("Counter:", counter());

// Each call to makeCounter() creates an independent counter
let counter2: func() int = makeCounter();
::println("Counter2:", counter2());

// ============================================================
// 2. Function factory: functions that generate other functions
// ============================================================
let makeMultiplier = func(factor: int): func(int) int {
    return func(x: int): int {
        return x * factor;
    };
};

let double: func(int) int = makeMultiplier(2);
let triple: func(int) int = makeMultiplier(3);
let tenX: func(int) int = makeMultiplier(10);

::println("\nDouble 7:", double(7));
::println("Triple 7:", triple(7));
::println("10x 7:", tenX(7));

// ============================================================
// 3. Higher-order function: map (apply function to each element)
// ============================================================
let map = func(arr: []int, f: func(int) int): []int {
    let result: []int;
    for item in arr {
        result = ::append(result, f(item));
    };
    return result;
};

let numbers: []int = [1, 2, 3, 4, 5];
let squared: []int = map(numbers, func(x: int): int { return x * x });
let doubled: []int = map(numbers, double);

::println("\nNumbers:", numbers);
::println("Squared:", squared);
::println("Doubled:", doubled);

// ============================================================
// 4. Higher-order function: filter
// ============================================================
let filter = func(arr: []int, predicate: func(int) bool): []int {
    let result: []int;
    for item in arr {
        if (predicate(item)) {
            result = ::append(result, item);
        };
    };
    return result;
};

let isEven = func(x: int): bool { return x % 2 == 0; };
let isPositive = func(x: int): bool { return x > 0; };

let mixed: []int = [-3, -1, 0, 2, 4, 7, 9];
::println("\nMixed:", mixed);
::println("Even:", filter(mixed, isEven));
::println("Positive:", filter(mixed, isPositive));

// ============================================================
// 5. Higher-order function: reduce (fold)
// ============================================================
let reduce = func(arr: []int, f: func(int, int) int, initial: int): int {
    let acc: int = initial;
    for item in arr {
        acc = f(acc, item);
    };
    return acc;
};

let sum: int = reduce(numbers, func(a: int, b: int): int { return a + b }, 0);
let product: int = reduce(numbers, func(a: int, b: int): int { return a * b }, 1);
let maxVal: int = reduce(numbers, func(a: int, b: int): int { if (a > b) { return a; }; return b; }, numbers[0]);

::println("\nNumbers:", numbers);
::println("Sum:", sum);
::println("Product:", product);
::println("Max:", maxVal);

// ============================================================
// 6. Composing functions
// ============================================================
let compose = func(f: func(int) int, g: func(int) int): func(int) int {
    return func(x: int): int {
        return f(g(x));
    };
};

let addOne = func(x: int): int { return x + 1; };
let square = func(x: int): int { return x * x; };

let squareThenAdd: func(int) int = compose(addOne, square);
let addThenSquare: func(int) int = compose(square, addOne);

::println("\nCompose examples:");
::println("squareThenAdd(4):", squareThenAdd(4));
::println("addThenSquare(4):", addThenSquare(4));

// ============================================================
// 7. Memoization (caching results with closures)
// ============================================================
let memoize = func(f: func(int) int): func(int) int {
    let cache: {string: int} = {};
    return func(n: int): int {
        let key: string = ::string(n);
        let cached: any = cache[key];
        if (cached != null) {
            return cached;
        };
        let result: int = f(n);
        cache[key] = result;
        return result;
    };
};

let factorial: func(int) int = memoize(func(n: int): int {
    if (n <= 1) { return 1; };
    let result: int = 1;
    for i in ::range(2, n + 1) {
        result = result * i;
    };
    return result;
});

::println("\nFactorials (memoized):");
::println("5! =", factorial(5));
::println("6! =", factorial(6));
::println("10! =", factorial(10));
