const redis = import("redis");

// Connect to Redis
let conn: any = redis.connect("localhost:6379");

// Basic operations
redis.set(conn, "greeting", "Hello, World!");
let message: string = redis.get(conn, "greeting");

// Hash operations
redis.hset(conn, "user:1", "name", "John Doe");
let user: {string: string} = redis.hgetall(conn, "user:1");

// List operations
redis.rpush(conn, "tasks", "task1", "task2");
let task: string = redis.lpop(conn, "tasks");

// Close connection
redis.close(conn);
