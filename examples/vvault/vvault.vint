import random

package vvault {
    let generate = func(length: int): string {
        let chars: string = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
        let charArray: []string = chars.split("")
        let result: string = ""
        for i in ::range(length) {
            result += random.choice(charArray)
        }
        return result
    }

    let password = func(length: int): string {
        return random.password(length)
    }

    let otp = func(length: int): string {
        return random.otp(length)
    }

    let token = func(length: int): string {
        return random.token(length)
    }
}
