// VintLang Typed Pointers
// Demonstrates typed pointer operations

// Declare typed pointer
let x: int = 42
let p: *int = &x

println("x:", x)
println("*p:", *p)

// Pointer mutation
*p = 100
println("x after *p = 100:", x)

// Pointer to struct
struct Point {
    x: float64
    y: float64
}

let pt: Point = Point{x: 3.0, y: 4.0}
let ptr: *Point = &pt
ptr.x = 10.0
ptr.y = 20.0
println("point via ptr:", pt.x, pt.y)

// Nil pointer safety
let nilPtr: *int
if nilPtr != nil {
    println(*nilPtr)
} else {
    println("nil pointer, cannot dereference")
}

// Pointer to array element
let arr: [3]int = [10, 20, 30]
let elem: *int = &arr[1]
*elem = 99
println("arr after pointer mutation:", arr)

// Function with pointer param
func increment(n: *int) {
    *n = *n + 1
}

let counter: int = 0
increment(&counter)
increment(&counter)
println("counter after increment calls:", counter)
