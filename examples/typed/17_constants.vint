// VintLang Typed Constants
// Demonstrates typed constant declarations

// Typed constants
const APP_NAME: string = "VintLang-Typed";
const VERSION: int = 7;
const PI: float64 = 3.14159265359;
const DEBUG: bool = true;
const MAX_CONNECTIONS: int = 1000;

println(APP_NAME, VERSION);
println("PI:", PI);

// Untyped constants
const TIMEOUT = 30;
const RATE = 0.05;
const PREFIX = "vint_";

// Use in typed contexts
let timeoutDuration: int = TIMEOUT;
let interestRate: float64 = RATE;
let prefixed: string = PREFIX + "types";

println(timeoutDuration, interestRate, prefixed);

// Constant expressions
const HOURS_PER_DAY: int = 24;
const MINUTES_PER_HOUR: int = 60;
const MINUTES_PER_DAY: int = HOURS_PER_DAY * MINUTES_PER_HOUR;
const SECONDS_PER_DAY: int = MINUTES_PER_DAY * 60;

println("minutes in a day:", MINUTES_PER_DAY);
println("seconds in a day:", SECONDS_PER_DAY);

// Constants in math
const GRAVITY: float64 = 9.81;
const SPEED_OF_LIGHT: int = 299792458;

let energy = func(mass: float64): float64 {
    return mass * (SPEED_OF_LIGHT as float64) * (SPEED_OF_LIGHT as float64);
};

println("E = mc^2:", energy(1.0));