// VintLang Typed Structs
// Demonstrates struct definitions with typed fields and methods

// Basic typed struct
struct Point {
    x: float64,
    y: float64
};

let p: Point = Point(x = 3.0, y = 4.0);
::println("Point:", p.x, p.y);

// Struct with methods
struct Rectangle {
    width: float64,
    height: float64,

    func area(): float64 {
        return this.width * this.height;
    },

    func perimeter(): float64 {
        return 2.0 * (this.width + this.height);
    }
};

let rect: Rectangle = Rectangle(width = 10.0, height = 5.0);
::println("area:", rect.area());
::println("perimeter:", rect.perimeter());

// Struct with typed fields + defaults
struct Config {
    host: string = "localhost",
    port: int = 8080,
    debugMode: bool = false
};

let defaultCfg: Config = Config();
let customCfg: Config = Config(port = 9090, debugMode = true);

::println("default:", defaultCfg.host, defaultCfg.port);
::println("custom:", customCfg.host, customCfg.port, customCfg.debugMode);

// Nested structs
struct Address {
    street: string,
    city: string,
    zipCode: string
};

struct Person {
    name: string,
    age: int,
    address: Address,
    tags: []string
};

let alice: Person = Person(
    name = "Alice",
    age = 30,
    address = Address(street = "123 Main St", city = "Portland", zipCode = "97201"),
    tags = ["developer", "golang"]
);

::println(alice.name, "lives at", alice.address.city);

// Struct with slice fields
struct Team {
    name: string,
    members: []string,
    scores: []int
};

let team: Team = Team(
    name = "VintDevs",
    members = ["Alice", "Bob", "Carol"],
    scores = [95, 88, 92]
);

for m in team.members {
    ::println("member:", m);
};