// VintLang Typed Errors
// Demonstrates error handling with throw/catch

// Function that may error
let divide = func(a: int, b: int): int {
    if (b == 0) {
        throw("division by zero");
    };
    return a / b;
};

let result = divide(10, 2);
println("result:", result);

// Custom error types
error ValidationError { field: string, reason: string };
let err = ValidationError{field: "id", reason: "must be positive"};
println("error type:", type(err));