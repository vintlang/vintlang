// VintLang Typed Enums
// Demonstrates enum declarations (typed enums deferred to v2)

// Simple enum
enum Status {
    Pending = 0,
    Active = 1,
    Inactive = 2,
    Banned = 3
};

let currentStatus: Status = Status.Active;
println("status:", currentStatus);

// Enum as function parameter type
let canLogin = func(status: Status): bool {
    return status == Status.Active;
};

println("can login:", canLogin(currentStatus));
println("can login banned:", canLogin(Status.Banned));

// Enum in struct field
struct User {
    id: int,
    name: string,
    role: Status
};

let admin: User = User{id: 1, name: "Alice", role: Status.Active};
println("user:", admin.name, "role:", admin.role);