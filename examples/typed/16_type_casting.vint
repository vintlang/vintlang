// VintLang Type Casting and Checking
// Demonstrates 'as' (cast) and 'is' (type check) operators

// ============================================================
// 1. Type casting with 'as'
// ============================================================

let x: int = 42
let y: float64 = x as float64
println("int to float:", y)

let pi: float64 = 3.14159
let n: int = pi as int  // truncates, 3
println("float to int:", n)

let s: string = "100"
let val: int = s as int
println("string to int:", val)

let b: bool = 1 as bool
println("int to bool:", b)

// ============================================================
// 2. Type checking with 'is'
// ============================================================

func checkType(val: any): string {
    if val is int {
        return "integer"
    }
    if val is string {
        return "string"
    }
    if val is float64 {
        return "float"
    }
    if val is bool {
        return "boolean"
    }
    if val is []any {
        return "array"
    }
    if val is {string: any} {
        return "dict"
    }
    if val is nil {
        return "nil"
    }
    return "unknown"
}

println(checkType(42))
println(checkType("hello"))
println(checkType(3.14))
println(checkType(true))
println(checkType([1, 2, 3]))
println(checkType(nil))

// ============================================================
// 3. Safe type assertion
// ============================================================

func addIfInt(a, b: any): ?int {
    if a is int && b is int {
        return (a as int) + (b as int)
    }
    return nil
}

println(addIfInt(3, 4) ?? -1)
println(addIfInt(3, "hello") ?? -1)

// ============================================================
// 4. Conversion between numeric types
// ============================================================

let big: int64 = 1000
let small: int8 = big as int8  // truncates if overflow

let precise: float64 = 3.14159265358979
let approx: float32 = precise as float32

println("int64 to int8:", small)
println("float64 to float32:", approx)

// ============================================================
// 5. Casting in expressions
// ============================================================

func divideInt(a, b: int): float64 {
    return (a as float64) / (b as float64)
}

let ratio: float64 = divideInt(10, 3)
println("10 / 3 =", ratio)
