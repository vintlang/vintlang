// VintLang Typed Functions
// Demonstrates function type annotations

// Basic typed functions
let add = func(a: int, b: int): int {
    return a + b;
};

let greet = func(name: string): string {
    return "Hello, " + name + "!";
};

let isEven = func(n: int): bool {
    return n % 2 == 0;
};

::println(add(3, 4));
::println(greet("VintLang"));
::println(isEven(7));

// Functions with no return value
let logMessage = func(msg: string) {
    ::println("[LOG]", msg);
};

logMessage("system initialized");

// Function as value (type annotation for variable)
let op: func(int, int) int = add;
::println("via func var:", op(10, 20));

// Higher-order functions (one line)
let apply = func(arr: []int, fn: func(int) int): []int { return fn(arr[0]) };
let double = func(n: int): int { return n * 2 };
let nums: []int = [1, 2, 3, 4, 5];
::println("applied:", apply(nums, double));

// Anonymous functions / closures
let makeCounter = func(start: int): func() int {
    let count: int = start;
    return func(): int {
        count = count + 1;
        return count;
    };
};

let counter: func() int = makeCounter(0);
::println(counter());
::println(counter());
::println(counter());