// VintLang Zero Values
// Demonstrates Go-style zero values for all types

// Primitive zero values
let zBool: bool;
let zInt: int;
let zString: string;
let zFloat64: float64;
let zAny: any;

::println("bool:", zBool);
::println("int:", zInt);
::println("float64:", zFloat64);
::println("string:", zString);
::println("any:", zAny);

// Compound type zero values
let zSlice: []int;
let zDict: {string: int};
let zPointer: *int;
let zFunc: func() int;

::println("slice:", zSlice);
::println("dict:", zDict);
::println("pointer:", zPointer);
::println("func:", zFunc);

// Struct zero values
struct Config {
    host: string,
    port: int,
    debugMode: bool
};

let zCfg: Config;
::println("struct host:", zCfg.host);
::println("struct port:", zCfg.port);
::println("struct debug:", zCfg.debugMode);

// Nested zero values
struct Inner {
    value: int,
    label: string
};

struct Outer {
    inner: Inner,
    items: []int,
    meta: {string: any}
};

let zOuter: Outer;
::println("outer.inner.value:", zOuter.inner.value);
::println("outer.items:", zOuter.items);

// Zero value in struct initialization
struct User {
    id: int,
    name: string,
    email: string,
    role: string
};

let u: User = User{id: 1, name: "Alice"};
::println("user:", u.name, u.email, u.role);

// nil slice is safe to append
let items: []int;
items = ::append(items, 1);
items = ::append(items, 2);
items = ::append(items, 3);
::println("items from nil:", items);