// VintLang Typed Optionals
// Demonstrates Zig-inspired optional types for nullable safety

// ============================================================
// 1. Optional type declaration
// ============================================================

let name: ?string = "Alice"
let age: ?int = nil
let score: ?float64 = 95.5

println("name:", name)
println("age:", age)
println("score:", score)

// ============================================================
// 2. Unwrapping optionals
// ============================================================

func greet(name: ?string): string {
    if name != nil {
        return "Hello, " + name! + "!"
    }
    return "Hello, stranger!"
}

println(greet("VintLang"))
println(greet(nil))

// ============================================================
// 3. Optional chaining (safe navigation)
// ============================================================

struct Address {
    street: string
    city: string
}

struct Profile {
    name: string
    address: ?Address
}

let user1: ?Profile = Profile{
    name: "Alice",
    address: Address{street: "123 Main", city: "Portland"}
}

let user2: ?Profile = Profile{
    name: "Bob",
    address: nil
}

// Safe access with ?.
let city1: ?string = user1?.address?.city
let city2: ?string = user2?.address?.city

println("Alice's city:", city1 ?? "unknown")
println("Bob's city:", city2 ?? "unknown")

// ============================================================
// 4. Default values with ??
// ============================================================

func getDisplayName(name: ?string): string {
    return name ?? "Anonymous"
}

println(getDisplayName("Alice"))
println(getDisplayName(nil))

// ============================================================
// 5. Optional in function returns
// ============================================================

func findIndex(arr: []int, target: int): ?int {
    for i, v in arr {
        if v == target {
            return i
        }
    }
    return nil
}

let numbers: []int = [10, 20, 30, 40, 50]
let idx: ?int = findIndex(numbers, 30)
let notFound: ?int = findIndex(numbers, 99)

println("index of 30:", idx ?? -1)
println("index of 99:", notFound ?? -1)

// ============================================================
// 6. Structs with optional fields
// ============================================================

struct User {
    id: int
    name: string
    email: ?string
    phone: ?string
}

let users: []User = [
    User{id: 1, name: "Alice", email: "alice@example.com", phone: nil},
    User{id: 2, name: "Bob", email: nil, phone: "+1-555-0123"}
]

for u in users {
    let contact: string = u.email ?? u.phone ?? "no contact info"
    println(u.name, ":", contact)
}
