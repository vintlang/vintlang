// VintLang Typed Any
// Demonstrates the 'any' type (Go's interface{} equivalent)

// any type variables
let v: any = 42;
::println("int as any:", v);

v = "hello";
::println("string as any:", v);

v = [1, 2, 3];
::println("slice as any:", v);

v = nil;
::println("nil as any:", v);

// Type checking with 'is'
let describe = func(val: any): string {
    if (val is int) {
        return "integer";
    };
    if (val is string) {
        return "string";
    };
    if (val is bool) {
        return "boolean";
    };
    return "unknown";
};

::println(describe("hello"));
::println(describe(42));
::println(describe(true));

// Collections with any
let mixed: []any = [42, "hello", true, nil];
for item in mixed {
    ::println("mixed:", item);
};