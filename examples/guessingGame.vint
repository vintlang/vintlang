import math, random

// Guessing game in Vint
let guess: int = ::int(::input("Guess a number: "))

let number: int = random.int(1, 10)
while (number != guess) {
    // Check if the guess is correct
    if (number == guess) {
        ::println("Woo hoo you've guessed it right!")
        break
    } else if (number > guess) {
        ::println("Too small")
    } else {
        ::println("Too big")
    }

    // Prompt for a new guess if incorrect
    guess = ::int(::input("Guess Again: "))
}
::println("Woo hoo you've guessed it right")
::println("Game over!")
